# WAHA instance (required)
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=replace-with-your-waha-api-key
# Public URL of this MCP server (https required, except localhost)
PUBLIC_BASE_URL=https://mcp.example.com

# Optional (defaults shown)
WAHA_SESSION=default
DATA_DIR=/data
PORT=3000
TIMEZONE=UTC
STATS_MAX_MESSAGES=5000
MEDIA_LINK_TTL_SECONDS=600
MEDIA_INLINE_MAX_BYTES=5242880
