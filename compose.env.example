# waha-mcp + WAHA with Docker Compose.
#
# Copy to .env next to docker-compose.yml, or let `sh scripts/init-env.sh` do it: the script
# fills every <generate> value with a random secret (mode 600, nothing printed).
# Generate a value by hand with:  openssl rand -base64 32   (MASTER_KEY)
#                                 openssl rand -hex 32      (the other secrets)
# Never commit .env. Keep an offline copy of MASTER_KEY: without it the encrypted cache is lost.

# --- Required -----------------------------------------------------------------------------

# Public origin of waha-mcp, no path.
#   VPS with the bundled HTTPS proxy (profile "https"): https://<DOMAIN>
#   Laptop:                                              http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# 32 random bytes in base64; wraps every tenant's encryption key.
MASTER_KEY=<generate>

# Your login on waha-mcp's OAuth page (3-32 of A-Z a-z 0-9 . - _; password 12+ characters).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=<generate>

# Shared by WAHA and waha-mcp (waha-mcp sends it as X-Api-Key). Never shown to users.
WAHA_API_KEY=<generate>

# Signs WAHA's webhooks to waha-mcp: keeps edits, deletions, reactions and poll votes in sync.
# Leave empty to turn webhooks off.
WAHA_WEBHOOK_SECRET=<generate>

# Login of WAHA's own dashboard and Swagger (reachable only from this machine, see below).
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=<generate>

# --- Common options -----------------------------------------------------------------------

# IANA time zone for dates and day boundaries.
TIMEZONE=UTC

# WAHA session of the owner's WhatsApp; WAHA starts it on every boot.
WAHA_SESSION=default

# Single-owner by default. true: invite other people (each with their own WhatsApp).
MULTI_TENANT=false

# Days cached messages and transcripts are kept (0 keeps them forever).
CACHE_RETENTION_DAYS=90

# Domain for the bundled Caddy HTTPS proxy (profile "https"); its DNS A/AAAA record must point
# at this server and ports 80 and 443 must be open. Unused on a laptop.
DOMAIN=

# --- Ports and images ---------------------------------------------------------------------

# Where waha-mcp is published on the host. Keep 127.0.0.1 behind the bundled proxy or your own.
WAHA_MCP_BIND=127.0.0.1
WAHA_MCP_PORT=3000

# WAHA's API and dashboard, published on 127.0.0.1 only (use an SSH tunnel from a VPS).
WAHA_HOST_PORT=3001

# WAHA image, per CPU: "gows" is amd64 only, "gows-arm" is arm64 (Apple Silicon, ARM VPS);
# scripts/init-env.sh picks it for this machine. GOWS with media needs WAHA 2026.6.1 or later;
# pin a version tag (e.g. gows-2026.10.1, gows-arm-2026.10.1) for reproducible installs.
WAHA_IMAGE=devlikeapro/waha:gows

# --- Optional features (see README > Configuration) ---------------------------------------

# Password recovery by email through Cloudflare Email Service (all three or none). The sender's
# domain must be onboarded under Email Service > Email Sending; the token needs Email Sending
# permission. ADMIN_EMAIL is the owner's address for recovery.
EMAIL_FROM=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
ADMIN_EMAIL=

# Voice-note transcription (all three or none).
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Missions and scheduled messages (needs WAHA_WEBHOOK_SECRET).
OPENROUTER_API_KEY=
